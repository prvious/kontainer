{
  "paths": {
    "/api/v1/auth/bootstrap": {
      "get": {
        "operationId": "bootstrap",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapResponse"
                }
              }
            },
            "description": "Whether the owner account exists; reveals nothing beyond setup being done"
          },
          "503": {
            "description": "Persistence unavailable"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "super::password_auth"
        ]
      }
    },
    "/api/v1/auth/password/login": {
      "post": {
        "operationId": "password_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordSessionResponse"
                }
              }
            },
            "description": "Signed in; credentials returned once"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            },
            "description": "Field errors (`validation_failed`)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidCredentialsResponse"
                }
              }
            },
            "description": "Email or password is incorrect"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LockedResponse"
                }
              }
            },
            "description": "Ten failures locked this email for fifteen minutes"
          },
          "503": {
            "description": "Persistence unavailable"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "super::password_auth"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordSessionResponse"
                }
              }
            },
            "description": "Owner created and signed in; credentials returned once"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            },
            "description": "Field errors (`validation_failed`)"
          },
          "409": {
            "description": "An owner already exists (`owner_exists`); registration is closed"
          },
          "503": {
            "description": "Persistence unavailable"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "super::password_auth"
        ]
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "current_session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            },
            "description": "The signed-in principal's email and display name"
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access credential"
          },
          "503": {
            "description": "Session persistence unavailable"
          }
        },
        "tags": [
          "super::account"
        ]
      }
    }
  },
  "schemas": {
    "AccountResponse": {
      "properties": {
        "displayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "principalId": {
          "type": "string"
        }
      },
      "required": [
        "principalId"
      ],
      "type": "object"
    },
    "BootstrapResponse": {
      "properties": {
        "ownerExists": {
          "type": "boolean"
        }
      },
      "required": [
        "ownerExists"
      ],
      "type": "object"
    },
    "InvalidCredentialsResponse": {
      "properties": {
        "attemptsRemaining": {
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        },
        "error": {
          "description": "Always `invalid_credentials`, for an unknown email and a wrong password alike.",
          "type": "string"
        }
      },
      "required": [
        "error",
        "attemptsRemaining"
      ],
      "type": "object"
    },
    "LockedResponse": {
      "properties": {
        "error": {
          "description": "Always `locked`.",
          "type": "string"
        },
        "retryAfterSeconds": {
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "error",
        "retryAfterSeconds"
      ],
      "type": "object"
    },
    "PasswordLoginRequest": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "required": [
        "email",
        "password"
      ],
      "type": "object"
    },
    "PasswordSessionResponse": {
      "description": "Issued exactly once per sign-in, with `Cache-Control: no-store`.",
      "properties": {
        "accessCredential": {
          "type": "string"
        },
        "accessExpiresAt": {
          "type": "string"
        },
        "clusterId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "principalId": {
          "type": "string"
        },
        "refreshCredential": {
          "type": "string"
        },
        "refreshExpiresAt": {
          "type": "string"
        }
      },
      "required": [
        "clusterId",
        "principalId",
        "email",
        "displayName",
        "accessCredential",
        "refreshCredential",
        "accessExpiresAt",
        "refreshExpiresAt"
      ],
      "type": "object"
    },
    "RegisterRequest": {
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "password": {
          "description": "12–128 characters. JSON body only; never logged or echoed.",
          "type": "string"
        }
      },
      "required": [
        "displayName",
        "email",
        "password"
      ],
      "type": "object"
    },
    "ValidationErrorResponse": {
      "properties": {
        "error": {
          "description": "Always `validation_failed`.",
          "type": "string"
        },
        "fields": {
          "type": "object"
        }
      },
      "required": [
        "error",
        "fields"
      ],
      "type": "object"
    }
  },
  "securitySchemes": {
    "access_session": {
      "bearerFormat": "opaque",
      "scheme": "bearer",
      "type": "http"
    }
  }
}
