{
  "paths": {
    "/api/v1/cluster/samples": {
      "get": {
        "operationId": "cluster_samples",
        "parameters": [
          {
            "description": "One of 5m, 15m, 1h, 24h, 7d",
            "in": "query",
            "name": "window",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Bucket width such as 5s, 60s, 15m; at most 200 points",
            "in": "query",
            "name": "bucket",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SampleSeriesResponse"
                }
              }
            },
            "description": "Per bucket: mean CPU over contributing nodes, summed figures, and the contributor count"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeErrorResponse"
                }
              }
            },
            "description": "Invalid window or bucket"
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access credential"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeErrorResponse"
                }
              }
            },
            "description": "Persistence unavailable or controller draining"
          }
        },
        "security": [
          {
            "access_session": []
          }
        ],
        "tags": [
          "super::nodes"
        ]
      }
    },
    "/api/v1/nodes": {
      "get": {
        "operationId": "list_nodes",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeListResponse"
                }
              }
            },
            "description": "Every node that has checked in, with derived status and latest sample"
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access credential"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeErrorResponse"
                }
              }
            },
            "description": "Persistence unavailable or controller draining"
          }
        },
        "security": [
          {
            "access_session": []
          }
        ],
        "tags": [
          "super::nodes"
        ]
      }
    },
    "/api/v1/nodes/{nodeId}/containers": {
      "get": {
        "operationId": "index",
        "parameters": [
          {
            "description": "Configured node ID; only the statically configured node is served",
            "in": "path",
            "name": "nodeId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page size; defaults to 50, range 1-100",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Opaque cursor from a previous page; empty means the first page",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "maxLength": 67,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContainerPageResponse"
                }
              }
            },
            "description": "One bounded page preserving agent order; live collections are best-effort"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContainerErrorResponse"
                }
              }
            },
            "description": "Invalid pagination; no agent call was made"
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access credential"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContainerErrorResponse"
                }
              }
            },
            "description": "Unknown node; only nodes that have checked in exist"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContainerErrorResponse"
                }
              }
            },
            "description": "Agent unavailable or response invalid; no transport or daemon detail"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContainerErrorResponse"
                }
              }
            },
            "description": "Agent deadline expired"
          }
        },
        "tags": [
          "super::containers"
        ]
      }
    },
    "/api/v1/nodes/{nodeId}/samples": {
      "get": {
        "operationId": "node_samples",
        "parameters": [
          {
            "description": "Node id",
            "in": "path",
            "name": "nodeId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "One of 5m, 15m, 1h, 24h, 7d",
            "in": "query",
            "name": "window",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Bucket width such as 5s, 60s, 15m; at most 200 points",
            "in": "query",
            "name": "bucket",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SampleSeriesResponse"
                }
              }
            },
            "description": "Averages per bucket; buckets without samples are null"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeErrorResponse"
                }
              }
            },
            "description": "Invalid window or bucket"
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access credential"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeErrorResponse"
                }
              }
            },
            "description": "Unknown node"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeErrorResponse"
                }
              }
            },
            "description": "Persistence unavailable or controller draining"
          }
        },
        "security": [
          {
            "access_session": []
          }
        ],
        "tags": [
          "super::nodes"
        ]
      }
    },
    "/api/v1/operations/{operation_id}": {
      "get": {
        "operationId": "operation",
        "parameters": [
          {
            "description": "Durable operation UUID",
            "in": "path",
            "name": "operation_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResponse"
                }
              }
            },
            "description": "Current durable operation state"
          },
          "400": {
            "description": "Invalid operation identifier"
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access credential"
          },
          "404": {
            "description": "Operation not found or not visible to the authenticated principal"
          },
          "500": {
            "description": "Operation state unavailable"
          },
          "503": {
            "description": "Controller draining new work or session persistence unavailable; the body is either HealthResponse or a generic error"
          }
        },
        "tags": [
          "super::operations"
        ]
      }
    },
    "/api/v1/settings": {
      "patch": {
        "operationId": "update_settings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsPatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsResponse"
                }
              }
            },
            "description": "Settings after the change"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeErrorResponse"
                }
              }
            },
            "description": "Malformed body or unknown field"
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access credential"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeErrorResponse"
                }
              }
            },
            "description": "metricsRetentionDays outside 1–365"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeErrorResponse"
                }
              }
            },
            "description": "Persistence unavailable or controller draining"
          }
        },
        "security": [
          {
            "access_session": []
          }
        ],
        "tags": [
          "super::settings"
        ]
      }
    }
  },
  "schemas": {
    "ContainerErrorResponse": {
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "ContainerItemResponse": {
      "properties": {
        "containerId": {
          "description": "Full lowercase-hex daemon container ID.",
          "type": "string"
        },
        "createdAt": {
          "description": "RFC 3339 UTC creation time with millisecond precision.",
          "type": "string"
        },
        "displayName": {
          "description": "Canonical display name without Docker linkage.",
          "type": "string"
        },
        "imageReference": {
          "description": "Image reference as reported by the daemon.",
          "type": "string"
        },
        "nodeId": {
          "description": "Serving node ID from agent configuration, never request input.",
          "type": "string"
        },
        "state": {
          "$ref": "#/components/schemas/ContainerStateResponse",
          "description": "Typed lifecycle state."
        },
        "status": {
          "description": "Bounded daemon status text.",
          "type": "string"
        }
      },
      "required": [
        "containerId",
        "displayName",
        "imageReference",
        "state",
        "status",
        "createdAt",
        "nodeId"
      ],
      "type": "object"
    },
    "ContainerPageResponse": {
      "properties": {
        "items": {
          "description": "One bounded page preserving the agent's deterministic newest-first\norder. Live collections are best-effort: containers created or removed\nbetween calls can shift pages. A cursor whose target was removed is\nrejected as invalid pagination; restart traversal from the first page.",
          "items": {
            "$ref": "#/components/schemas/ContainerItemResponse"
          },
          "maxItems": 100,
          "type": "array"
        },
        "nextCursor": {
          "description": "Opaque cursor for the next page, or null when this page is last.\nPass back unchanged; clients never decode or synthesize it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "nextCursor"
      ],
      "type": "object"
    },
    "ContainerStateResponse": {
      "enum": [
        "unknown",
        "created",
        "running",
        "paused",
        "restarting",
        "removing",
        "exited",
        "dead",
        "stopping"
      ],
      "type": "string"
    },
    "NodeErrorResponse": {
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "NodeListResponse": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/components/schemas/NodeResponse"
          },
          "type": "array"
        },
        "snapshotAt": {
          "type": "string"
        }
      },
      "required": [
        "items",
        "snapshotAt"
      ],
      "type": "object"
    },
    "NodeResponse": {
      "properties": {
        "agentStartedAt": {
          "type": "string"
        },
        "agentVersion": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "availability": {
          "type": [
            "string",
            "null"
          ]
        },
        "cpuCores": {
          "format": "int32",
          "type": "integer"
        },
        "dockerVersion": {
          "type": "string"
        },
        "firstSeenAt": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "id": {
          "description": "Node id from the agent's certificate identity.",
          "type": "string"
        },
        "lastCheckInAt": {
          "type": "string"
        },
        "latestSample": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/components/schemas/NodeSampleResponse"
            }
          ]
        },
        "memoryTotalBytes": {
          "format": "int64",
          "type": "integer"
        },
        "os": {
          "type": "string"
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/components/schemas/NodeStatusResponse",
          "description": "Derived from the last check-in: `online` within 15 s, `degraded` within 60 s."
        },
        "swarmNodeId": {
          "description": "Swarm fields are null until Swarm inventory fills them.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "hostname",
        "status",
        "swarmNodeId",
        "role",
        "availability",
        "agentVersion",
        "dockerVersion",
        "os",
        "arch",
        "cpuCores",
        "memoryTotalBytes",
        "agentStartedAt",
        "firstSeenAt",
        "lastCheckInAt",
        "latestSample"
      ],
      "type": "object"
    },
    "NodeSampleResponse": {
      "properties": {
        "containersExited": {
          "format": "int32",
          "type": "integer"
        },
        "containersPaused": {
          "format": "int32",
          "type": "integer"
        },
        "containersRunning": {
          "format": "int32",
          "type": "integer"
        },
        "cpuPercent": {
          "description": "0–100 of the node.",
          "format": "float",
          "type": "number"
        },
        "diskUsedBytes": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "memoryUsedBytes": {
          "format": "int64",
          "type": "integer"
        },
        "netRxBytesPerSec": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "netTxBytesPerSec": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "sampledAt": {
          "type": "string"
        }
      },
      "required": [
        "sampledAt",
        "cpuPercent",
        "memoryUsedBytes",
        "diskUsedBytes",
        "containersRunning",
        "containersPaused",
        "containersExited",
        "netRxBytesPerSec",
        "netTxBytesPerSec"
      ],
      "type": "object"
    },
    "NodeStatusResponse": {
      "enum": [
        "online",
        "degraded",
        "offline"
      ],
      "type": "string"
    },
    "OperationResponse": {
      "properties": {
        "createdAt": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "lastErrorCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastEventSequence": {
          "format": "int32",
          "type": "integer"
        },
        "recoverable": {
          "type": "boolean"
        },
        "state": {
          "$ref": "#/components/schemas/OperationStateResponse"
        },
        "uncertain": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "state",
        "recoverable",
        "uncertain",
        "lastEventSequence",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    },
    "OperationStateResponse": {
      "enum": [
        "recoverable",
        "running",
        "uncertain",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "SamplePointResponse": {
      "properties": {
        "at": {
          "description": "Bucket start.",
          "type": "string"
        },
        "containersRunning": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "cpuPercent": {
          "description": "Null when no sample landed in the bucket, never 0.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "diskUsedBytes": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "memoryUsedBytes": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "netRxBytesPerSec": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "netTxBytesPerSec": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "nodes": {
          "description": "Nodes that contributed a sample to the bucket.",
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "at",
        "cpuPercent",
        "memoryUsedBytes",
        "diskUsedBytes",
        "containersRunning",
        "netRxBytesPerSec",
        "netTxBytesPerSec",
        "nodes"
      ],
      "type": "object"
    },
    "SampleSeriesResponse": {
      "properties": {
        "bucket": {
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/components/schemas/SamplePointResponse"
          },
          "type": "array"
        },
        "snapshotAt": {
          "type": "string"
        },
        "window": {
          "type": "string"
        }
      },
      "required": [
        "window",
        "bucket",
        "points",
        "snapshotAt"
      ],
      "type": "object"
    },
    "SettingsPatchRequest": {
      "additionalProperties": false,
      "properties": {
        "metricsRetentionDays": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "SettingsResponse": {
      "properties": {
        "metricsRetentionDays": {
          "description": "Days of node samples kept, 1–365.",
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "metricsRetentionDays"
      ],
      "type": "object"
    }
  },
  "securitySchemes": {
    "access_session": {
      "bearerFormat": "opaque",
      "scheme": "bearer",
      "type": "http"
    }
  }
}
