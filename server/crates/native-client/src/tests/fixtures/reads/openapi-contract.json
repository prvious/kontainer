{
  "paths": {
    "/api/v1/cluster/samples": {
      "get": {
        "operationId": "cluster_samples",
        "parameters": [
          {
            "description": "One of 5m, 15m, 1h, 24h, 7d",
            "in": "query",
            "name": "window",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Bucket width such as 5s, 60s, 15m; at most 200 points",
            "in": "query",
            "name": "bucket",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SampleSeriesResponse"
                }
              }
            },
            "description": "Per bucket: mean CPU over contributing nodes, summed figures, and the contributor count"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeErrorResponse"
                }
              }
            },
            "description": "Invalid window or bucket"
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access credential"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeErrorResponse"
                }
              }
            },
            "description": "Persistence unavailable or controller draining"
          }
        },
        "security": [
          {
            "access_session": []
          }
        ],
        "tags": [
          "super::nodes"
        ]
      }
    },
    "/api/v1/containers": {
      "get": {
        "operationId": "list_containers",
        "parameters": [
          {
            "description": "Only this member node",
            "in": "query",
            "name": "node",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContainerListResponse"
                }
              }
            },
            "description": "Containers on every answering node, and one outcome per member node"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmissionErrorResponse"
                }
              }
            },
            "description": "Invalid query"
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access credential"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmissionErrorResponse"
                }
              }
            },
            "description": "No such member node"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TooManyContainersResponse"
                }
              }
            },
            "description": "`too_many_containers`: more than 2,000; filter by node"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmissionErrorResponse"
                }
              }
            },
            "description": "Agent RPC not configured, persistence unavailable, or controller draining"
          }
        },
        "security": [
          {
            "access_session": []
          }
        ],
        "tags": [
          "super::containers"
        ]
      }
    },
    "/api/v1/containers/actions/bulk": {
      "post": {
        "operationId": "containers_bulk_action",
        "parameters": [
          {
            "description": "16–64 printable ASCII characters, one per user gesture",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkActionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmittedResponse"
                }
              }
            },
            "description": "Admitted as one `containers.bulk` operation"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmissionErrorResponse"
                }
              }
            },
            "description": "`idempotency_key_required` or `invalid_request`"
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access credential"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmissionErrorResponse"
                }
              }
            },
            "description": "`idempotency_conflict`"
          },
          "503": {
            "description": "Persistence unavailable or controller draining"
          }
        },
        "security": [
          {
            "access_session": []
          }
        ],
        "tags": [
          "super::containers"
        ]
      }
    },
    "/api/v1/containers/{nodeId}/{containerId}/actions/{action}": {
      "post": {
        "operationId": "container_action",
        "parameters": [
          {
            "description": "Member node id",
            "in": "path",
            "name": "nodeId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Full container id",
            "in": "path",
            "name": "containerId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "start, stop, restart, pause, unpause, or remove",
            "in": "path",
            "name": "action",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "16–64 printable ASCII characters, one per user gesture",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/ContainerActionRequest"
                  }
                ]
              }
            }
          },
          "description": "Optional; empty means defaults"
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmittedResponse"
                }
              }
            },
            "description": "Admitted; poll the operation"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmissionErrorResponse"
                }
              }
            },
            "description": "`idempotency_key_required` or `invalid_request`"
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access credential"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmissionErrorResponse"
                }
              }
            },
            "description": "No such member node"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmissionErrorResponse"
                }
              }
            },
            "description": "`idempotency_conflict`"
          },
          "503": {
            "description": "Persistence unavailable or controller draining"
          }
        },
        "security": [
          {
            "access_session": []
          }
        ],
        "tags": [
          "super::containers"
        ]
      }
    },
    "/api/v1/nodes": {
      "get": {
        "operationId": "list_nodes",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeListResponse"
                }
              }
            },
            "description": "Every node that has checked in, with derived status and latest sample"
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access credential"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeErrorResponse"
                }
              }
            },
            "description": "Persistence unavailable or controller draining"
          }
        },
        "security": [
          {
            "access_session": []
          }
        ],
        "tags": [
          "super::nodes"
        ]
      }
    },
    "/api/v1/nodes/{nodeId}/samples": {
      "get": {
        "operationId": "node_samples",
        "parameters": [
          {
            "description": "Node id",
            "in": "path",
            "name": "nodeId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "One of 5m, 15m, 1h, 24h, 7d",
            "in": "query",
            "name": "window",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Bucket width such as 5s, 60s, 15m; at most 200 points",
            "in": "query",
            "name": "bucket",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SampleSeriesResponse"
                }
              }
            },
            "description": "Averages per bucket; buckets without samples are null"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeErrorResponse"
                }
              }
            },
            "description": "Invalid window or bucket"
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access credential"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeErrorResponse"
                }
              }
            },
            "description": "Unknown node"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeErrorResponse"
                }
              }
            },
            "description": "Persistence unavailable or controller draining"
          }
        },
        "security": [
          {
            "access_session": []
          }
        ],
        "tags": [
          "super::nodes"
        ]
      }
    },
    "/api/v1/operations/noop": {
      "post": {
        "operationId": "admit_noop",
        "parameters": [
          {
            "description": "16–64 printable ASCII characters, one per user gesture",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmittedResponse"
                }
              }
            },
            "description": "Admitted; poll the operation"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmissionErrorResponse"
                }
              }
            },
            "description": "`idempotency_key_required` or `invalid_request`"
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access credential"
          },
          "404": {
            "description": "Not available outside development and test"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmissionErrorResponse"
                }
              }
            },
            "description": "`idempotency_conflict`: the key was used for a different request"
          },
          "503": {
            "description": "Persistence unavailable or controller draining"
          }
        },
        "security": [
          {
            "access_session": []
          }
        ],
        "tags": [
          "super::operations"
        ]
      }
    },
    "/api/v1/operations/{operation_id}": {
      "get": {
        "operationId": "operation",
        "parameters": [
          {
            "description": "Durable operation UUID",
            "in": "path",
            "name": "operation_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResponse"
                }
              }
            },
            "description": "Current durable operation state"
          },
          "400": {
            "description": "Invalid operation identifier"
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access credential"
          },
          "404": {
            "description": "Operation not found or not visible to the authenticated principal"
          },
          "500": {
            "description": "Operation state unavailable"
          },
          "503": {
            "description": "Controller draining new work or session persistence unavailable; the body is either HealthResponse or a generic error"
          }
        },
        "tags": [
          "super::operations"
        ]
      }
    },
    "/api/v1/operations/{operation_id}/cancel": {
      "post": {
        "operationId": "cancel_operation",
        "parameters": [
          {
            "description": "Durable operation UUID",
            "in": "path",
            "name": "operation_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResponse"
                }
              }
            },
            "description": "Cancelled before it started; the body is the operation"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmissionErrorResponse"
                }
              }
            },
            "description": "Invalid operation identifier"
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access credential"
          },
          "404": {
            "description": "Operation not found or not visible to the authenticated principal"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmissionErrorResponse"
                }
              }
            },
            "description": "`not_cancellable`: the operation already started or finished"
          },
          "503": {
            "description": "Persistence unavailable or controller draining"
          }
        },
        "security": [
          {
            "access_session": []
          }
        ],
        "tags": [
          "super::operations"
        ]
      }
    },
    "/api/v1/operations/{operation_id}/events": {
      "get": {
        "operationId": "operation_events",
        "parameters": [
          {
            "description": "Durable operation UUID",
            "in": "path",
            "name": "operation_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Return events after this sequence (default 0)",
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "At most this many events, 1–100 (default 100)",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationEventsResponse"
                }
              }
            },
            "description": "Events in sequence order"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmissionErrorResponse"
                }
              }
            },
            "description": "Invalid operation identifier or query"
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access credential"
          },
          "404": {
            "description": "Operation not found or not visible to the authenticated principal"
          },
          "503": {
            "description": "Persistence unavailable or controller draining"
          }
        },
        "security": [
          {
            "access_session": []
          }
        ],
        "tags": [
          "super::operations"
        ]
      }
    },
    "/api/v1/settings": {
      "patch": {
        "operationId": "update_settings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsPatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsResponse"
                }
              }
            },
            "description": "Settings after the change"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeErrorResponse"
                }
              }
            },
            "description": "Malformed body or unknown field"
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access credential"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeErrorResponse"
                }
              }
            },
            "description": "metricsRetentionDays outside 1–365"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeErrorResponse"
                }
              }
            },
            "description": "Persistence unavailable or controller draining"
          }
        },
        "security": [
          {
            "access_session": []
          }
        ],
        "tags": [
          "super::settings"
        ]
      }
    }
  },
  "schemas": {
    "AdmissionErrorResponse": {
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "AdmittedResponse": {
      "properties": {
        "operationId": {
          "type": "string"
        },
        "replayed": {
          "description": "True when this key already admitted the same request; no second operation exists.",
          "type": "boolean"
        }
      },
      "required": [
        "operationId",
        "replayed"
      ],
      "type": "object"
    },
    "BulkActionRequest": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "description": "start, stop, restart, pause, unpause, or remove.",
          "type": "string"
        },
        "force": {
          "description": "Remove only: kill running containers first.",
          "type": "boolean"
        },
        "targets": {
          "description": "1–200 containers on any member nodes.",
          "items": {
            "type": "object"
          },
          "maxItems": 200,
          "type": "array"
        }
      },
      "required": [
        "action",
        "targets"
      ],
      "type": "object"
    },
    "ContainerActionRequest": {
      "additionalProperties": false,
      "properties": {
        "force": {
          "description": "Remove only: kill a running container first.",
          "type": "boolean"
        },
        "timeoutSeconds": {
          "description": "Stop and restart only: grace before kill, 0–600 (default 10).",
          "format": "int32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ContainerListResponse": {
      "description": "`{ items, nodes, snapshotAt }`: merged containers and one outcome per member node.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/components/schemas/ContainerResponse"
          },
          "maxItems": 2000,
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/components/schemas/NodeOutcomeResponse"
          },
          "type": "array"
        },
        "snapshotAt": {
          "type": "string"
        }
      },
      "required": [
        "items",
        "nodes",
        "snapshotAt"
      ],
      "type": "object"
    },
    "ContainerResponse": {
      "properties": {
        "containerId": {
          "description": "Full lowercase-hex daemon container ID.",
          "type": "string"
        },
        "cpuPercent": {
          "description": "From the node's last sample; null when not running.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "type": "string"
        },
        "memoryLimitBytes": {
          "format": "int64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "memoryUsedBytes": {
          "format": "int64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "nodeId": {
          "type": "string"
        },
        "nodeName": {
          "description": "The node's hostname.",
          "type": "string"
        },
        "ports": {
          "description": "Published ports as `host:container/proto`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "serviceName": {
          "type": [
            "string",
            "null"
          ]
        },
        "stackNamespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/components/schemas/ContainerStateResponse"
        },
        "status": {
          "description": "Bounded daemon status text, e.g. `Up 3 minutes`.",
          "type": "string"
        },
        "taskId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "nodeId",
        "nodeName",
        "containerId",
        "name",
        "image",
        "state",
        "status",
        "createdAt",
        "startedAt",
        "finishedAt",
        "ports",
        "serviceName",
        "stackNamespace",
        "taskId",
        "cpuPercent",
        "memoryUsedBytes",
        "memoryLimitBytes"
      ],
      "type": "object"
    },
    "ContainerStateResponse": {
      "enum": [
        "unknown",
        "created",
        "running",
        "paused",
        "restarting",
        "removing",
        "exited",
        "dead",
        "stopping"
      ],
      "type": "string"
    },
    "NodeErrorResponse": {
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "NodeListResponse": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/components/schemas/NodeResponse"
          },
          "type": "array"
        },
        "snapshotAt": {
          "type": "string"
        }
      },
      "required": [
        "items",
        "snapshotAt"
      ],
      "type": "object"
    },
    "NodeOutcomeResponse": {
      "description": "Per-node result shared by every fan-out route.",
      "properties": {
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "nodeId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/components/schemas/NodeOutcomeStatus"
        }
      },
      "required": [
        "nodeId",
        "status"
      ],
