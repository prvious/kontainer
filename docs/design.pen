            {
              "type": "text",
              "id": "RRr7O",
              "name": "capNote",
              "fill": "$--muted-foreground",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "The controller checks email and password together and never says which one was wrong, so a mistyped email and a wrong password look the same. The password field turns destructive and clears; the typed URL and email stay. After 10 failures in 15 minutes the controller locks that email for 15 minutes and the helper says when to retry. Nothing is stored locally until a session is issued. There is no self-service reset: the CLI on the controller host resets the password.",
              "lineHeight": 1.55,
              "fontFamily": "$--font-mono",
              "fontSize": "$--text-2xs",
              "fontWeight": "normal"
            }
          ]
        }
      ]
