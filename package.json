{
    "name": "kontainer",
    "private": true,
    "scripts": {
        "dev": "./dev/setup.sh && goreman -f dev/Procfile start",
        "dev:app": "pnpm --filter app tauri dev",
        "dev:agent": "cd server && air",
        "dev:cluster": "./dev/setup.sh",
        "reset": "./dev/teardown.sh && rm -f server/storage/*.db server/storage/*.db-wal server/storage/*.db-shm",
        "down": "./dev/teardown.sh",
        "dev:cluster:rm": "./dev/teardown.sh",
        "dev:cluster:seed": "./dev/seed-services.sh",
        "build": "pnpm run build:app & pnpm run build:agent & wait",
        "build:app": "pnpm --filter app build",
        "build:agent": "cd server && go build -o bin/agent .",
        "lint": "pnpm --filter app lint",
        "fmt": "pnpm --filter app fmt",
        "types": "pnpm --filter app types"
    }
}
