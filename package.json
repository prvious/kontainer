{
    "name": "kontainer",
    "private": true,
    "scripts": {
        "dev:app": "pnpm --filter app tauri dev",
        "dev:controller": "cd server && KONTAINER_DOCKER_HOST=tcp://localhost:2375 cargo run --bin kontainer-controller -- start",
        "dev:pki": "./dev/pki.sh",
        "dev:agents": "./dev/agents.sh start",
        "dev:agents:stop": "./dev/agents.sh stop",
        "dev:smoke": "./dev/smoke.sh",
        "dev:cluster": "./dev/setup.sh",
        "reset": "./dev/teardown.sh",
        "dev:cluster:seed": "./dev/seed-services.sh",
        "build": "pnpm run build:app && pnpm run build:server",
        "build:app": "pnpm --filter app build",
        "build:server": "cargo build --manifest-path server/Cargo.toml --workspace",
        "test:server": "cargo test --manifest-path server/Cargo.toml --workspace",
        "lint:server": "cargo clippy --manifest-path server/Cargo.toml --workspace --all-targets -- -D warnings",
        "fmt:server": "cargo fmt --manifest-path server/Cargo.toml --all -- --check",
        "lint": "pnpm --filter app lint",
        "fmt": "pnpm --filter app fmt",
        "types": "pnpm --filter app types"
    },
    "devDependencies": {
        "shadcn": "^4.1.0"
    }
}
